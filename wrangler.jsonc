{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "business-flights-travel-website",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Required by `wrangler preview`, the default Workers Builds command for
  // non-production branches (pull-request builds). Empty = inherit the top-level
  // settings (Preview variables/secrets are configured separately in Cloudflare).
  "previews": {}
}
